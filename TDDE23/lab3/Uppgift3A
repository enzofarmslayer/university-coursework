import math

def new_board():
    return {}

def is_free(board, x, y):
    if (x,y) in board:
        return False
    else:
        return True

def place_piece(board, x, y, player):
    if is_free(board, x, y):
        board[(x,y)] = player
        return True
    else:
        return False
         
def get_piece(board, x, y):
    if is_free(board, x, y):
        return False
    else:
        return (board[(x,y)])

def remove_piece(board, x, y):
    if is_free(board, x, y):
        return False
    else:
        board.pop((x,y))
        return True
    
def move_piece(board, x1, y1, x2, y2):
    if is_free(board, x2, y2) and not is_free(board, x1, y1):
        board[(x2,y2)] = board[(x1,y1)]
        board.pop((x1,y1))
        return True
    else:
        return False
    
def count(board, row_or_col, position, player):
    sum = 0
    i = 0
    
    if row_or_col == "column":
        i = 0
    else:
        i = 1

    for key in board:
        if key[i] == position and board[key] == player:
            sum += 1
    return sum

def nearest_piece(board, x, y):
        
    if len(board) == 0:
        return False
    
    distanceDic = {}
    distanceList = []

    for key in board:
        distanceDic[key] = 0
    
    for key in distanceDic:
        z = (key[0] - x)**2 + (key[1] - y)**2
        distance = math.sqrt(z)
        distanceList.append(distance)
        distanceDic[key] = distance

    distanceList.sort()
    for key in distanceDic:
        if distanceDic[key] == distanceList[0]:
            return key
